{
  "manifest_version": 3,
  "name": "Hack Club Tools",
  "short_name": "Hack Club Tools",
  "version": "0.1.0",
  "description": "Small tools that bring Hack Club to the web. Starts with a ring around the GitHub avatars of people who have shipped a project with Hack Club.",
  "homepage_url": "https://hackclub.com",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Hack Club Tools",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api2.hackclub.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/tools/shipped-ring/content.js"],
      "css": ["src/tools/shipped-ring/content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "hack-club-tools@hackclub.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
